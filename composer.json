{
  "name": "lumio/whmcs-module",
  "description": "Official Lumio provisioning module for WHMCS",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "LumioWhmcsTests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test:php": "phpunit --configuration phpunit.xml.dist",
    "test:admin-ui": "node --test --test-isolation=none tests/Js/AdminServerConfig.test.js",
    "test": [
      "@test:php",
      "@test:admin-ui"
    ]
  }
}
